#!/bin/sh
# Codex 또는 Claude Code를 공통 작업 접수 프롬프트로 시작한다.

set -eu

usage() {
  printf '%s\n' '사용법: ./scripts/ai-start <codex|claude>' >&2
  exit 64
}

[ "$#" -eq 1 ] || usage

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
cd "$repo_root"

initial_prompt='이 저장소의 AGENTS.md와 docs/README.md를 먼저 읽어라. 아직 구체적인 작업 요청은 없으며, 첫 응답에서는 파일·Git·Jira·외부 시스템을 변경하지 마라. 다음 질문을 사용자에게 그대로 제시하고, 사용자의 선택 또는 자유 서술을 기다려라.

현재 레포 상태를 기준으로 어떤 방식으로 진행할까요?

1. 현재 상태 점검 및 다음 작업 제안
2. 진행 중인 작업 이어하기
3. 마이그레이션
4. 버그 수정
5. 기능 구현
6. 코드 리뷰
7. 설계·조사
8. 문서화
9. 기타 — 원하는 작업을 자유롭게 설명

사용자가 1번을 선택하면 docs/workflows/001-current-status.md를,
2번을 선택하면 docs/workflows/002-continue-work.md를 읽어라.
3번을 선택하면 docs/workflows/000-common.md와 docs/workflows/003-migration.md를,
4번은 000-common.md와 004-bug-fix.md를,
5번은 000-common.md와 005-new-feature.md를,
6번은 000-common.md와 006-code-review.md를,
7번은 000-common.md와 007-design-research.md를,
8번은 000-common.md와 008-documentation.md를 모두 읽어라.
문서를 읽고 종료하지 말고, 선택한 workflow를 세션의 활성 workflow로 유지하며 현재 단계를 안내하라. 단계 전환, 사용자 승인 필요, 범위 이탈, 구현·PR 직전 검증에서만 현재 단계·확정 사항·미결 질문·다음 결정을 짧게 정리하라.
새 요청은 현재 범위 내, 범위 변경, 별도 티켓으로 분류하고 범위 변경이나 별도 티켓이면 조용히 전환하지 말고 사용자에게 선택을 요청하라.
필요한 범위·완료 기준·권한을 먼저 확인하라. Jira 키와 사람이 생성한 작업 브랜치를 받았으면 현재 브랜치가 일치하는지만 확인하고, 브랜치를 생성·checkout·변경하지 마라.
9번 또는 자유 서술이면 작업 의도와 완료 기준을 파악한 뒤 적절한 workflow를 판정하라. 사용자 승인 전에는 파일이나 외부 상태를 변경하지 마라.'

case "$1" in
  codex|claude)
    command -v "$1" >/dev/null 2>&1 || {
      printf '%s 명령을 찾을 수 없습니다. 설치 또는 PATH를 확인하세요.\n' "$1" >&2
      exit 127
    }
    exec "$1" "$initial_prompt"
    ;;
  *)
    usage
    ;;
esac
