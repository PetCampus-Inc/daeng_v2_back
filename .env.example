# 로컬 개발용 환경변수 템플릿
# 이 파일을 복사해 .env.local 을 만들고 값을 채운다. (.env.local 은 커밋되지 않는다)
#   cp .env.example .env.local
#
# 사용법
#   1) MySQL 기동 : docker compose --env-file .env.local -f docker-compose.local.yaml up -d
#   2) 앱 실행    : set -a && source .env.local && set +a && ./gradlew bootRun --args='--spring.profiles.active=local'
#
# 값을 비워두면 각 파일에 정의된 기본값이 사용된다.

# --- DB 접속 (앱 + docker compose 공용) ---
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
DB_TIMEZONE=

# --- docker compose 전용 ---
DB_ROOT_PASSWORD=
DB_IMAGE=
DB_CONTAINER_NAME=
DB_VOLUME_NAME=

# --- Redis 접속 (앱 + docker compose 공용) ---
REDIS_HOST=
REDIS_PORT=
REDIS_IMAGE=
REDIS_CONTAINER_NAME=

# --- 애플리케이션 ---
SERVER_PORT=
JPA_DDL_AUTO=
JPA_SHOW_SQL=
FLYWAY_ENABLED=

# --- 인증(JWT) --- 로컬에서도 최소 32바이트 이상의 임의 문자열을 채운다 (HS256 요구 최소 길이)
JWT_ISSUER=
JWT_SECRET_KEY=

# --- 소셜 로그인(Google OIDC 클라이언트 ID, 공개 값) ---
OAUTH_GOOGLE_CLIENT_ID_WEB=
OAUTH_GOOGLE_CLIENT_ID_IOS=
OAUTH_GOOGLE_CLIENT_ID_ANDROID=
